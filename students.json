<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Điểm Danh Trực Tuyến</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="config.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            color: #1e293b;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: white;
            padding: 40px;
            border-radius: 16px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 1px solid #e2e8f0;
        }
        h2 { font-size: 24px; text-align: center; margin-bottom: 15px; font-weight: 700; }
        .badge { background: #e0f2fe; color: #0369a1; padding: 8px 14px; border-radius: 20px; font-weight: 600; font-size: 13px; display: block; text-align: center; margin-bottom: 25px; }
        label { font-size: 13px; font-weight: 600; color: #64748b; display: block; margin-top: 15px; margin-bottom: 6px; }
        input, select, textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
            background: white;
            color: #1e293b;
            box-sizing: border-box;
        }
        input:focus, select:focus, textarea:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,0.1); }
        input[readonly] { background: #f1f5f9; color: #64748b; cursor: not-allowed; }
        textarea { resize: vertical; height: 60px; }
        button {
            width: 100%;
            padding: 14px;
            margin-top: 20px;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }
        button:hover { background: #4338ca; }
        button:disabled { background: #cbd5e1; cursor: not-allowed; }
        .error { color: #ef4444; font-size: 14px; font-weight: 600; margin: 15px 0; padding: 12px; background: #fee2e2; border-radius: 10px; display: none; text-align: center; }
        .success { color: #10b981; font-size: 15px; font-weight: 600; margin-top: 15px; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <h2>🎓 Điểm Danh Trực Tuyến</h2>
        <div id="sessionBadge" class="badge">Đang kết nối phiên...</div>
        <div id="errorMsg" class="error"></div>

        <form id="attendanceForm">
            <label>Mã số sinh viên (MSSV)</label>
            <input type="text" id="mssv" placeholder="Nhập MSSV" required autocomplete="off">

            <label>Họ và Tên</label>
            <input type="text" id="studentName" placeholder="Tự động điền nếu MSSV đúng" readonly>

            <label>Lĩnh vực / Bộ phận</label>
            <select id="category" required>
                <option value="" disabled selected>-- Chọn --</option>
            </select>

            <label>Ghi chú công việc</label>
            <textarea id="note" placeholder="Nhập nội dung..." required></textarea>

            <button type="submit" id="submitBtn">✓ Xác nhận điểm danh</button>
        </form>

        <div id="message" class="success"></div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const currentSession = urlParams.get('phien');
        const qrToken = parseInt(urlParams.get('token'), 10);
        const refreshTime = parseInt(urlParams.get('refresh')) || 20;
        const errorBox = document.getElementById('errorMsg');
        const submitBtn = document.getElementById('submitBtn');
        const mssvInput = document.getElementById('mssv');
        let isValidStudent = false;

        async function initCheckin() {
            await loadStudents();
            const select = document.getElementById('category');
            CONFIG.CATEGORIES.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.text = cat;
                select.appendChild(opt);
            });
        }

        if (currentSession) {
            document.getElementById('sessionBadge').innerText = '✓ Phiên: ' + currentSession;
        } else {
            document.getElementById('sessionBadge').innerText = '⚠️ Chưa quét QR';
        }

        function showError(msg) {
            errorBox.innerText = msg;
            errorBox.style.display = 'block';
        }

        function verifyToken() {
            if (!qrToken) {
                showError('⚠️ Vui lòng quét QR từ trang quản lý!');
                submitBtn.disabled = true;
                return false;
            }

            const currentToken = Math.floor(Date.now() / (refreshTime * 1000));
            if (Math.abs(currentToken - qrToken) > 1) {
                showError('⚠️ QR đã hết hạn! Vui lòng quét QR mới nhất.');
                submitBtn.disabled = true;
                return false;
            }
            return true;
        }

        verifyToken();

        mssvInput.addEventListener('input', function() {
            const val = this.value.trim();
            if (!val) {
                document.getElementById('studentName').value = '';
                isValidStudent = false;
                submitBtn.disabled = true;
                errorBox.style.display = 'none';
                return;
            }

            const student = validStudents.find(s => s.mssv === val);
            if (student) {
                document.getElementById('studentName').value = student.name;
                errorBox.style.display = 'none';
                isValidStudent = true;
                submitBtn.disabled = false;
            } else {
                document.getElementById('studentName').value = '';
                isValidStudent = false;
                submitBtn.disabled = false;
            }
        });

        document.getElementById('attendanceForm').addEventListener('submit', function(e) {
            e.preventDefault();
            if (!verifyToken()) return;

            const mssv = mssvInput.value.trim();
            const name = document.getElementById('studentName').value.trim();
            const category = document.getElementById('category').value;
            const note = document.getElementById('note').value.trim();
            const msg = document.getElementById('message');

            if (!mssv) {
                showError('❌ Vui lòng nhập MSSV!');
                return;
            }

            if (!isValidStudent && !name) {
                showError('❌ MSSV không có trong danh sách. Vui lòng nhập tên sinh viên!');
                return;
            }

            const finalName = name || mssv;

            submitBtn.disabled = true;
            submitBtn.innerText = 'Đang xử lý...';

            fetch(CONFIG.GOOGLE_SHEET_API, {
                method: 'POST',
                mode: 'no-cors',
                body: JSON.stringify({
                    phien: currentSession || 'Mặc định',
                    mssv,
                    name: finalName,
                    category,
                    note,
                    timestamp: new Date().toLocaleString('vi-VN')
                })
            })
            .then(() => {
                msg.innerText = `✓ Tuyệt vời! ${finalName} đã điểm danh thành công.`;
                document.getElementById('attendanceForm').style.display = 'none';
                setTimeout(() => location.reload(), 2000);
            })
            .catch(() => {
                showError('⚠️ Lỗi kết nối! Vui lòng thử lại.');
                submitBtn.disabled = false;
                submitBtn.innerText = '✓ Xác nhận điểm danh';
            });
        });

        initCheckin();
    </script>
</body>
</html>
